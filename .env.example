# --- ریلز (مثل reels-mcp قبلی) ---
ZERNIO_API_KEY=       # آپلودر اصلی (zernio.com)؛ اگر خالی باشد فقط upload-post استفاده می‌شود
ZERNIO_ACCOUNT_ID=    # accountId اکانت اینستاگرام داخل Zernio
UPLOADPOST_API_KEYS=   # یک یا چند کلید با کاما جدا شده؛ به ترتیب امتحان می‌شوند (UPLOADPOST_API_KEY قدیمی هم کار می‌کند)
UPLOADPOST_USER=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
MCP_SECRET=            # حداقل ۲۴ کاراکتر؛ اکانت «default» و بخشی از آدرس
SITE_ADDR=your.domain.com
SSL_PORT=443
# --- گیت‌هاب ---
GITHUB_TOKEN=          # fine-grained: Contents و Pull requests (Read/Write)
ALLOWED_REPOS=Owner/Repo1,Owner/Repo2
